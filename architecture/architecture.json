{
  "version": 1,
  "repo": "..",
  "coverage": {
    "scope": "This Living Blueprint covers the public Live Architecture Context product loop: accepted source evidence, bounded candidate review, refresh and local last-good state, the optional Archify projection, and the local agent/viewer surfaces.",
    "limitations": [
      "Relations are authored, source-evidence-backed architecture claims; this view is not a complete call graph.",
      "CALM is packaged as an optional loopback adapter but is not configured for this repository, so no CALM code facts are shown.",
      "The diagram is a focused human view. Source, accepted context, and retained local receipts remain the authority for details and history.",
      "Saved-worktree activity is a separate local observation, not canonical architecture or runtime. Codex maintains semantic declarations; the live page never invokes a model.",
      "Native hook configuration does not prove host trust or delivery; offered cursors are not consumption receipts.",
      "Rendered IR, HTML, comparisons, snapshots, watcher state, and pinned renderer checkout stay in local .archctx state and are not GitHub facts."
    ]
  },
  "components": [
    {
      "id": "archctx-cli",
      "name": "Archctx CLI and MCP",
      "purpose": "Canonical source-evidence validation and compact CLI/MCP queries, including caller-cursor deltas and the shared, version-separated declared change scope consumed by the viewer.",
      "truth_sources": ["archctx.py", "pyproject.toml"],
      "code_symbol": "main",
      "tags": ["canonical", "agent-protocol", "source-evidence"],
      "evidence": [
        {"path": "archctx.py", "contains": "def mcp_tools() -> list[dict[str, Any]]:"},
        {"path": "archctx.py", "contains": "def updates(config_path: Path"},
        {"path": "archctx.py", "contains": "def change_scope(record: dict[str, Any]"},
        {"path": "pyproject.toml", "contains": "archctx = \"archctx:main\""}
      ]
    },
    {
      "id": "last-known-good-state",
      "name": "Last-good context state",
