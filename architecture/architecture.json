    },
    {
      "id": "development-observer",
      "name": "Development observation",
      "purpose": "Caches bounded worktree observations and caller-cursor updates, reusing the core declared change scope. Ordinary saves change the overlay; settled definitions request existing validation/publication. It owns no canonical architecture or event ledger.",
