    "compare": ["{python}", "{lac_runtime}", "--state", "{state}", "compare", "architecture", "{archify_before}", "{archify_output}", "{archify_compare}", "--receipt", "{archify_receipt}", "--quality", "standard", "--repo-root", "{repo}", "--json"],
