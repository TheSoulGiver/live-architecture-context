  "archify": {
    "view": "architecture/architecture.view.json",
    "output": "architecture/.archctx/architecture.archify.json",
    "validate": ["{python}", "tools/archify.py", "validate", "architecture", "{archify_output}", "--quality", "standard", "--repo-root", "{repo}", "--json"],
    "render": ["{python}", "tools/archify.py", "deliver", "architecture", "{archify_output}", "{archify_html}", "--quality", "standard", "--repo-root", "{repo}", "--json"],
    "compare": ["{python}", "tools/archify.py", "compare", "architecture", "{archify_before}", "{archify_output}", "{archify_compare}", "--receipt", "{archify_receipt}", "--quality", "standard", "--repo-root", "{repo}", "--json"],
    "timeout_seconds": 180
  },
  "drift_rules": [
    {
      "id": "blueprint-loopback-http-boundary",
      "kind": "new-local-http-boundary",
      "paths": ["archctx_blueprint.py"],
      "added_contains": ["ThreadingHTTPServer("]
    },
    {
      "id": "blueprint-source-evidence-boundary",
      "kind": "new-local-source-boundary",
      "paths": ["archctx_blueprint.py"],
      "added_contains": ["url.path == \"/source\""]
    },
    {
      "id": "archify-renderer-revision",
      "kind": "renderer-boundary-change",
      "paths": ["tools/archify.py"],
      "added_contains": ["REVISION ="]
    }
  ],
  "watch": {
    "paths": [
      "archctx.py",
      "archctx_hook.py",
      ".codex/hooks.json",
      "archctx_to_archify.py",
      "calm_query.py",
      "archctx_blueprint.py",
      "archctx_development.py",
      "tools/archify.py",
      "pyproject.toml",
      "plugins/live-architecture-context/.codex-plugin/plugin.json",
      "plugins/live-architecture-context/skills/*/SKILL.md"
    ],
    "ignore": [".archctx/*", "architecture/.archctx/*", ".calm/*", "__pycache__/*"]
  }
