      ]
    },
    {
      "id": "blueprint-viewer",
      "name": "Local Living Blueprint viewer",
      "purpose": "Displays the accepted Archify map and a separate saved-worktree overlay; node details, source evidence and retained deltas share accepted context identity. The local HTTP UI remains read-only; --live owns only its observer.",
